#!/bin/sh /etc/rc.common

START=90
USE_PROCD=1
PROG=/usr/bin/quickfile

start_service() {
	procd_open_instance quickfile
	procd_set_param command $PROG
	procd_append_param command -dir /
	procd_append_param command -api /cgi-bin/luci/quickfile/api/
	procd_append_param command -static /cgi-bin/luci/quickfile-static/
	procd_append_param command -sock /tmp/run/quickfile/quickfile.sock
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_set_param respawn
	# No core dumps from a root daemon, plus the original fd headroom. Both
	# limits must go into one call: procd_set_param limits builds a table, so a
	# second call with the same type replaces the first one (which is how the
	# previous core="unlimited" silently stopped taking effect).
	procd_set_param limits core="0 0" nofile="200000 200000"
	procd_close_instance quickfile
}
